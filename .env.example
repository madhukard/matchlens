# Load these into your shell; the app does not auto-load .env.
MATCHLENS_PROVIDER=openai
MATCHLENS_MODEL=gpt-6-sol
OPENAI_API_KEY=
# Azure: provider=azure; model is your deployment name, not a catalog alias.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# If no Azure key is supplied, use DefaultAzureCredential locally or managed identity in Azure.
MATCHLENS_AZURE_MANAGED_IDENTITY=false
# Only the local generation command calls models. Public API/MCP serve saved results.
